<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="PageTitleTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="36" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource ColorTextPrimaryBrush}" /></Style>
 <Style x:Key="SectionHeadingTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource ColorTextPrimaryBrush}" /></Style>
