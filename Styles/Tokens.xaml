<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Color x:Key="ColorBackground">#FF121212</Color><Color x:Key="ColorSurface">#FF1E1E1E</Color>
 <Color x:Key="ColorSurfaceElevated">#FF282828</Color><Color x:Key="ColorSurfaceSecondary">#FF242A33</Color><Color x:Key="ColorBorder">#FF3A414B</Color>
 <Color x:Key="ColorAccent">#FF168BFF</Color><Color x:Key="ColorAccentBright">#FF45A7FF</Color>
 <Color x:Key="ColorSuccess">#FF39E879</Color><Color x:Key="ColorWarning">#FFFFB547</Color><Color x:Key="ColorDanger">#FFF05B66</Color><Color x:Key="ColorInfo">#FF58B8F5</Color>
 <Color x:Key="ColorTextPrimary">#FFF5F7FA</Color><Color x:Key="ColorTextSecondary">#FFB5BDC8</Color><Color x:Key="ColorTextMuted">#FF858F9D</Color>
 <SolidColorBrush x:Key="ColorBackgroundBrush" Color="{StaticResource ColorBackground}" /><SolidColorBrush x:Key="ColorSurfaceBrush" Color="{StaticResource ColorSurface}" />
 <SolidColorBrush x:Key="ColorSurfaceElevatedBrush" Color="{StaticResource ColorSurfaceElevated}" /><SolidColorBrush x:Key="ColorSurfaceSecondaryBrush" Color="{StaticResource ColorSurfaceSecondary}" />
 <SolidColorBrush x:Key="ColorBorderBrush" Color="{StaticResource ColorBorder}" /><SolidColorBrush x:Key="ColorAccentBrush" Color="{StaticResource ColorAccent}" /><SolidColorBrush x:Key="ColorAccentBrightBrush" Color="{StaticResource ColorAccentBright}" />
 <SolidColorBrush x:Key="ColorSuccessBrush" Color="{StaticResource ColorSuccess}" /><SolidColorBrush x:Key="ColorWarningBrush" Color="{StaticResource ColorWarning}" /><SolidColorBrush x:Key="ColorDangerBrush" Color="{StaticResource ColorDanger}" /><SolidColorBrush x:Key="ColorInfoBrush" Color="{StaticResource ColorInfo}" />
 <SolidColorBrush x:Key="ColorTextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" /><SolidColorBrush x:Key="ColorTextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" /><SolidColorBrush x:Key="ColorTextMutedBrush" Color="{StaticResource ColorTextMuted}" />
 <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource ColorSurfaceSecondary}" />
 <x:Double x:Key="SpaceXS">4</x:Double><x:Double x:Key="SpaceS">8</x:Double><x:Double x:Key="SpaceM">16</x:Double><x:Double x:Key="SpaceL">24</x:Double><x:Double x:Key="SpaceXL">32</x:Double><x:Double x:Key="SpaceXXL">48</x:Double><x:Double x:Key="SpaceSection">60</x:Double>
 <CornerRadius x:Key="RadiusControl">8</CornerRadius><CornerRadius x:Key="RadiusCard">12</CornerRadius><CornerRadius x:Key="RadiusDialog">16</CornerRadius>
</ResourceDictionary>
